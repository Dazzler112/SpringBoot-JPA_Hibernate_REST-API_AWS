    //         return false
    //     }
    // }

    async function login(username, password) {

        const baToken = 'Basic ' + window.btoa(username + ":" + password)

        try {
            const response = await executeBasicAuthenticationService(baToken)

            if(response.status == 200) {
                setAuthenticated(true)
                setUsername(username)

                //6-1: 그럼 너는 이제 setToken()이라고 하고 너는 baToken을 호출할 수 있지, 이렇게 우린 baToken을 컨텍스트에 설정할 것이다 
                setToken(baToken)
                return true
            }else {
                setAuthenticated(false)
                setUsername(null)
                //6-2: 로그아웃을 할 때 모든 다른 곳에도 setToken(null)이라고 해주자, 그럼 else에서 setToken(null)이라고 해주고
                setToken(null)
                return false
            }
        } catch(error) {
            setAuthenticated(false)
            setUsername(null)

            //6-3: catch(error)에서도 setToken(null)이라고 해준다 그리고 logout()에서도 //6-4: logout()함수로..
            setToken(null)
            return false
        }
    }

    function logout() {
        setAuthenticated(false)

        //6-4:  setToken(null)이라고 해주자, 그럼 실제로 이렇게 해주는 게 더 좋다 
        setToken(null)

        //6-5: 그리고 setUsername(null)도 해주겠다
        setUsername(null)
    }

    return (
        <AuthContext.Provider value={ { isAuthenticated, login, logout, username} }>
            {children}
        </AuthContext.Provider>
    )
}

