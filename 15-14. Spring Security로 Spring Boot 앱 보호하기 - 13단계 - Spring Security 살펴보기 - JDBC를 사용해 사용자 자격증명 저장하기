프레임과 프레임세트가 들어 있다 
이렇게 HTML 프레임을 사용 중이지만 Spring Security에선 기본적으로 프레임을 사용 해제한다

그래서 프레임을 사용 설정해야 한다

설정하려면
BasicAuthSecurityConfiguration으로 가서 

--------------------------------------------------------------------------------------------

⏺ sts 

⏺ BasicAuthSecurityConfiguration.java


package com.example.spring_security_learn_practice.basic;

import static org.springframework.security.config.Customizer.*;

import org.springframework.context.annotation.*;
import org.springframework.security.config.annotation.web.builders.*;
import org.springframework.security.config.http.*;
import org.springframework.security.core.userdetails.*;
import org.springframework.security.provisioning.*;
import org.springframework.security.web.*;

@Configuration
public class BasicAuthSecurityConfiguration {

	@Bean
	SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {
		
		http.authorizeHttpRequests(
				auth -> {
					auth.anyRequest().authenticated();
					});
		http.sessionManagement(
					session -> 
					session.sessionCreationPolicy(
							SessionCreationPolicy.STATELESS) 
					);
//		http.formLogin(withDefaults());
		http.httpBasic(withDefaults());
		
		http.csrf().disable();

    //3: 필터 체인 안에 http.headers().frameOptions().sameOrigin()을 작성해야 한다
    //요청이 동일한 오리진에서 오는 경우 해당 애플리케이션에 프레임을 허용하도록 지정하는 것이다
    //예를 들어 example.com에서 호스팅되는 애플리케이션에는 프레임을 적용하고 evil.com의 애플리케이션에는 적용하지 않는 것이다 저장하고
    http.headers().frameOptions().sameOrigin();

		return http.build();
	}
	
	@Bean
	public UserDetailsService userDetailsService() {
		
		var user = User.withUsername("player")
			.password("{noop}dummy")
			.roles("USER") 
			.build();
		
		var admin = User.withUsername("admin")
				.password("{noop}dummy")
				.roles("ADMIN") 
				.build();
			
		return new InMemoryUserDetailsManager(user, admin); 
	}
}

--------------------------------------------------------------------------------------------

애플리케이션이 다시 시작되면 새로고침한다
