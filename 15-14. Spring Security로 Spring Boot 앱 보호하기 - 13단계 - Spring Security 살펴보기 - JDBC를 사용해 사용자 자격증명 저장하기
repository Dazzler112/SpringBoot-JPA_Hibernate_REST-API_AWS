

이 단계에선 DB에 사용자 자격증명을 저장하는 방법을 배운다
DB에 연결하기 위해 JDBC, Java Database Connectivity를 이용한다
DB로는 H2 인메모리 DB를 이용한다

먼저 의존성을 추가하겠다
build.gradle 파일을 열고
여기에 의존성을 몇 개 추가하겠다

--------------------------------------------------------------------------------------------

⏺ sts 

⏺ build.gradle


plugins {
	id 'java'
	id 'war'
	id 'org.springframework.boot' version '3.3.3'
	id 'io.spring.dependency-management' version '1.1.6'
}

group = 'com.spring-security-learn-practice'
version = '3.3.3'

java {
	toolchain {
		languageVersion = JavaLanguageVersion.of(17)
	}
}

repositories {
	mavenCentral()
}

dependencies {
	implementation 'org.springframework.boot:spring-boot-starter-security'
	implementation 'org.springframework.boot:spring-boot-starter-web'
	implementation 'org.springframework.boot:spring-boot-devtools'

<!--1: 첫 번째는 spring-boot-starter-jdbc이고-->
  implementation 'org.springframework.boot:spring-boot-starter-jdbc'

<!--1-1: 두 번째는 h2 데이터베이스이다 아티팩트ID는 h2이고 spring-boot-starter-jdbc이고 그룹 ID는 com.h2database 이다-->
<!--의존성을 정확하게 입력하라 com.h2database:h2이다 org.springframework.boot:spring-boot-starter-jdbc도 추가했다 이제 저장-->
  implementation 'com.h2database:h2'

	providedRuntime 'org.springframework.boot:spring-boot-starter-tomcat'
	testImplementation 'org.springframework.boot:spring-boot-starter-test'
	testImplementation 'org.springframework.security:spring-security-test'
	testRuntimeOnly 'org.junit.platform:junit-platform-launcher'
}

tasks.named('test') {
	useJUnitPlatform()
}

