

우린 많은 API 호출을 하고 있고
API 호출을 할 때마다 인증을 위해 토큰을 전송하려고 한다 
어떻게 하면 그걸 일반화시킬 수 있을까?

토큰을 공통적으로 적용할 방법은 없을까?

이번 단계부터는 그걸 탐구해보려고 한다 
우린 두 가지 API 클라이언트를 사용하고 있다는 걸 이미 확인했지

하나는 
--------------------------------------------------------------------------------------------
⏺vsc 


⏺ HelloWorldApiSevice.js


import axios from 'axios'


// export function retrieveHelloWorldBean() {
//     return axios.get('http://localhost:8080/hello-world-bean')
// }

const apiClient = axios.create(
    {
        baseURL: 'http://localhost:8080'
    }
)

export const retrieveHelloWorldBean 
        = () => apiClient.get('/hello-world-bean')

//Response to preflight request doesn't pass access control check => Authorization header
export const retrieveHelloWorldPathVariable 
        = (username, token) => apiClient.get(`/hello-world/path-variable/${username}`, {
            headers:{
                Authorization: token
            }
})

export const executeBasicAuthenticationService 
        = (token) => apiClient.get(`/basicauth`, {
            headers:{
                Authorization: token
            }
})        
