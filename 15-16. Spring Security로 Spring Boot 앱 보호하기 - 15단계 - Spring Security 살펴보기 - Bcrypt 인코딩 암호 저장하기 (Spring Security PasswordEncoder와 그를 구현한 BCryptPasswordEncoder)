//	}
	
	@Bean
	public DataSource dataSource() {
		
		return new EmbeddedDatabaseBuilder()
				.setType(EmbeddedDatabaseType.H2)
				.addScript(JdbcDaoImpl.DEFAULT_USER_SCHEMA_DDL_LOCATION)
				.build();
	}
	
	@Bean
	public UserDetailsService userDetailsService(DataSource dataSource) {
		
		var user = User.withUsername("player")
			.password("{noop}dummy")
			.roles("USER")
			.build();
		
		var admin = User.withUsername("admin") 
				.password("{noop}dummy")
				.roles("ADMIN", "USER") 
				.build();
		
		//JDBC 방식으로 유저 저장
		var jdbcUserDetailManager = new JdbcUserDetailsManager(dataSource);
		jdbcUserDetailManager.createUser(user);	
		jdbcUserDetailManager.createUser(admin);	
		
		return jdbcUserDetailManager; 
	}

  //1: @Bean을 추가하고 
	@Bean
  //1-1: public BCryptPasswordEncoder passwordEncoder()라고 작성한 후 {}안에
	public BCryptPasswordEncoder passwordEncoder() {
		//1-2: return new BCryptPasswordEncoder라고 작성한다, 임포트를 정리한다 org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder가 임포트되는걸 알 수 있다
    return new BCryptPasswordEncoder();
	}

