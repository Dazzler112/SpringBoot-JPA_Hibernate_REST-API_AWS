package com.example.spring_security_learn_practice.resources;

import org.springframework.web.bind.annotation.*;

import jakarta.servlet.http.*;

@RestController
public class SpringSecurityPlayResource {

	@GetMapping("/csrf-token")
  //3-1: 문자열이 아니라 Csrf 토큰으로 수정해야 한다 ctrl+스페이스를 누르면 CsrfToken인터페이스가 있다
  //(String 에서 CsrfToken으로 수정..)
	public CsrfToken retrieveCsrfToke(HttpServletRequest request) {

    //3: CSRF 속성을 가져온다고 작성했다, 그리고 반환타입을 수정해야한다
		return request.getAttribute("_csrf");
	}
}

