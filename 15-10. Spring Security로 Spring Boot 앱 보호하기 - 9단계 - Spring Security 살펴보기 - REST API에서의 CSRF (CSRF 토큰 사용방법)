public class SpringSecurityPlayResource {

//1: 그런 다음 URL은 /csrf-token 을 지정한다
	@GetMapping("/csrf-token")
//1-1: 그리고 retrieveCsrfToken이라고 작성한다
	public String retrieveCsrfToke() {

		return "Hello World v1";
	}
}

