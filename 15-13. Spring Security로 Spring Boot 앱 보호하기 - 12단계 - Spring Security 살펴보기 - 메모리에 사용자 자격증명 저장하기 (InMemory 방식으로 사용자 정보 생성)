이 인메모리 설정은 application.properties에 설정한 값을 기준으로 한다 (spring.security.user.name=player,spring.security.user.password=dummy)
application.properties 사용의 문제는 여기에 사용자 ID와 패스워드를 하나만 설정할 수 있다는 것이다
사용자 ID와 패스워드를 더 많이 설정해야 할 때 문제가 된다
메모리에 여러 사용자를 설정하는 방법을 알아보고, 다음 단계에선 DB에 자격증명을 저장하는 방법도 알아보겠다

먼저 여러 사용자를 생성하겠다


BasicAuthSecurityConfiguration을 열어서 UserDetailsService를 설정한다

--------------------------------------------------------------------------------------------

⏺ sts 

⏺ BasicAuthSecurityConfiguration.java


package com.example.spring_security_learn_practice.basic;

import static org.springframework.security.config.Customizer.*;

import org.springframework.context.annotation.*;
import org.springframework.security.config.annotation.web.builders.*;
import org.springframework.security.config.http.*;
import org.springframework.security.web.*;

@Configuration
public class BasicAuthSecurityConfiguration {

	@Bean
	SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {
		
		http.authorizeHttpRequests(
				auth -> {
					auth.anyRequest().authenticated();
					});
		http.sessionManagement(
					session -> 
					session.sessionCreationPolicy( //세션정책을 설정함
							SessionCreationPolicy.STATELESS) //세션 사용 안함으로
					);
//		http.formLogin(withDefaults());
		http.httpBasic(withDefaults());
		
		//csrf 설정을 해제
		http.csrf().disable();
		
		return http.build();
	}

  @Bean
  //1: 바로 여기에서 public UserDetailsService를 사용한다 매개변수는 입력하지 않는다 {} 넣고
	public UserDetailsService userDetailsService() {

      //1-1: return new InMemoryUserDetailsManager를 작성한다 임포트를 정리한다
      return new InMemoryUserDetailsManager();
	}
}

--------------------------------------------------------------------------------------------

임포트가 몇 개 추가된 게 보인다, InMemoryUserDetailsManager가 org.springframework.security.provisioning에서 추가되고
UerDetailsService도 추가됐다
UserDetailsService는 사용자별 데이터를 로드하는 코어 인터페이스라고 한다 (Core interface which loads user-specific data. )
사용자 세부 정보를 가져올 때 이 인터페이스를 사용하게 되고

InMemoryUserDetailsManager는 UserDetailsManager의 비지속적 구현이다
