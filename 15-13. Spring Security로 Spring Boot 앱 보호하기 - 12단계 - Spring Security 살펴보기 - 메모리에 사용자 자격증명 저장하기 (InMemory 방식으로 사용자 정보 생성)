package com.example.spring_security_learn_practice.basic;

import static org.springframework.security.config.Customizer.*;

import org.springframework.context.annotation.*;
import org.springframework.security.config.annotation.web.builders.*;
import org.springframework.security.config.http.*;
import org.springframework.security.core.userdetails.*;
import org.springframework.security.provisioning.*;
import org.springframework.security.web.*;

@Configuration
public class BasicAuthSecurityConfiguration {

	@Bean
	SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {
		
		http.authorizeHttpRequests(
				auth -> {
					auth.anyRequest().authenticated();
					});
		http.sessionManagement(
					session -> 
					session.sessionCreationPolicy( //세션정책을 설정함
							SessionCreationPolicy.STATELESS) //세션 사용 안함으로
					);
//		http.formLogin(withDefaults());
		http.httpBasic(withDefaults());
		
		//csrf 설정을 해제
		http.csrf().disable();
		
		return http.build();
	}
	
	@Bean
	public UserDetailsService userDetailsService() {

    //3:봐라 User.withUsername을 이와같이 이용해서 설정하면 된다 사용자 이름은 in28minutes로 설정할 것이다
    User.withUsername("in28minutes")
    //3-1: 이 코드는 빌더를 반환하기 때문에 다른 세부 정보도 모두 설정할 수 있다 .password를 설정하는데,
    //일단은 인코딩을 하지 않을 거라서 noop를 사용한다, 인코딩, 해싱, 암호화에 대해선 나중에 설명하겠다 일단은 패스워드를 dummy로 저장한다
        .password("{noop}dummy")
    //3-2: 여기에 역할을 할당할 건데, 어떤 사용자에 대해서든 역할을 할당할 수 있다, 역할을 여러개 할당할 수도 있다
    //이 사용자에게는 USER 역할을 할당할 건데, 원하면 역할을 추가할 수 있다, 역할을 하나만 지정하고
    .roles("USER")
    //3-3: 빌드한다 
    .build();

		return new InMemoryUserDetailsManager();
	}
}
