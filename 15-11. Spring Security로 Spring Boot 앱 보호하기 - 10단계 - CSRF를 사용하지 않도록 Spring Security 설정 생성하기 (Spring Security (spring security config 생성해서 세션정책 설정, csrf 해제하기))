package com.example.spring_security_learn_practice.basic;

import static org.springframework.security.config.Customizer.*;

import org.springframework.boot.autoconfigure.security.*;
import org.springframework.context.annotation.*;
import org.springframework.core.annotation.*;
import org.springframework.security.config.annotation.web.builders.*;
import org.springframework.security.web.*;

@Configuration
public class BasicAuthSecurityConfiguration {

	@Bean
	SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {

    //4: authorizeHttpRequests에 auth -> 함수를 넣고 {}안에 모든 인증 로직을 정의한다 바로
				http.authorizeHttpRequests(auth -> {
			 
    //4-1: 여기에 auth.anyRequest().authenticated()라고 작성한다
                          auth.anyRequest().authenticated();
		});

		http.formLogin(withDefaults());
		http.httpBasic(withDefaults());
		return http.build();
	}
}

--------------------------------------------------------------------------------------------

이렇게 authorizeHttpRequests를 설정하고 
모든 요청을 인증하도록 정의했다
formLogin과 httpBasic도 설정할 수있다
(		http.formLogin(withDefaults());, http.httpBasic(withDefaults());)


