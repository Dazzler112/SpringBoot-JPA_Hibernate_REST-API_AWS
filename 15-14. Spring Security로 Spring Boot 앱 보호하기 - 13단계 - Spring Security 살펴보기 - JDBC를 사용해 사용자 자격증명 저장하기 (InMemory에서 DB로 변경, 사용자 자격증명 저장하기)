//5-1: 이제는 데이터 소스를 이용하고 DB안에 사용자를 삽입할 것이다 DataSource dataSource라고 입력해서 데이터 소스 Bean을 여기에 주입한다
//그런 다음 이 사용자를 생성하는데 
	@Bean
	public UserDetailsService userDetailsService(DataSource dataSource) {

    //5-2: 이부분들은 괜찮지만 InMemoryUserDetailsManager는 사용하지 않는다
		var user = User.withUsername("player")
			.password("{noop}dummy")
			.roles("USER")
			.build();
		
		var admin = User.withUsername("admin") 
				.password("{noop}dummy")
				.roles("ADMIN") 
				.build();

    //5-3: 대신 jdbcUserDetailsManager를 사용한다, jdbcUserDetailsManager를 설정해야 하는데 이것은 
    //(Jdbc user management service, based on the same table structure as its parent class, JdbcDaoImpl. Provides CRUD operations for both users and groups. ) Jdbc 사용자 관리 서비스이고 사용자와 그룹 모두에 CRUD연산을 제공한다
    //JdbcUserDetailsManager를 선택하고 new를 추가해 주자 생성자 매개변수는 dataSource로 입력하고 var jdbcUserDetailsManager를 선언한다 
    var jdbcUserDetailManager = new JdbcUserDetailsManager(dataSource);

    //5-4: 그런 다음 jdbcUserDetailsManager를 삽입하고 createUser(user)와
    jdbcUserDetailManager.createUser(user);	

    //5-5: createUser(admin)을 작성한다
    jdbcUserDetailManager.createUser(admin);	

    //InMemoryUserDetailsManager를 반환하는 게 아니라 jdbcUserDetailsManager를 반환하도록 작성했다, 이제 저장한다
		return jdbcUserDetailManager;
	}
