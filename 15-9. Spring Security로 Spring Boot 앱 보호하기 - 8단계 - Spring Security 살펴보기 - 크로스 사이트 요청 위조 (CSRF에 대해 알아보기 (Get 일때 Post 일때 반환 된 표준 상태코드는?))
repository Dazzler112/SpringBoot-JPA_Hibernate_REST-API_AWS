package com.example.spring_security_learn_practice.resources;

import java.util.*;

import org.springframework.web.bind.annotation.*;

@RestController
public class TodoResource {

	private static final List<Todo> TODOS_LIST = 
			List.of(new Todo("in28minutes", "Learn AWS"),
					new Todo("in28minutes", "Get AWS Certified"));

	@GetMapping("/todos")
	public List<Todo> retrieveAllTodos() {
		return TODOS_LIST;
	}
	
	@GetMapping("/users/{username}/todos")
    //7: 여기에는 @PathVariable을 사용하는데 타입은 String 이름은 username이다 임포트를 정리한다 org.springframework.web.bind.annotation.PathVariable이 추가돼서 경로 변수가 임포트된다
	public List<Todo> retrieveTodosForSpecificUser(@PathVariable String username) {

    //7-1: 그런 다음 여기서 필터 로직을 작성할 수 있는데 TODOS_LIST.get(0)을 사용한다
		return TODOS_LIST.get(0);
	}
}

