package com.example.spring_security_learn_practice.resources;

import java.util.*;

import org.springframework.web.bind.annotation.*;

@RestController
public class TodoResource {

	private static final List<Todo> TODOS_LIST = 
			List.of(new Todo("player", "Learn AWS"),
					new Todo("player", "Get AWS Certified"));

	@GetMapping("/todos")
	public List<Todo> retrieveAllTodos() {
		return TODOS_LIST;
	}
	
	@GetMapping("/users/{username}/todos")
	public Todo retrieveTodosForSpecificUser(@PathVariable String username) {
		return TODOS_LIST.get(0);
	}

  //9: PostMapping이라고 수정하고 특정 사용자에게 Todo를 추가하려고 한다
  //URL은 동일하게 /users/{username/todos}를 사용할 것이다 이건 됐고
	@GetMapping("/users/{username}/todos")
//9-1: 메소드명은 retrieve대신 createTodosForSpecificUser라고 작성한다, @PathVariable String name 은 그대로 두고, 이 메서드는 반환값이 없도록 할 것이다
//간단한 void 메서드를 사용한다, 일단은 아무것도 실행하지 않을 것이다 그리고 @RequestBody를 추가하고 특정 Todo를 가져올 것이므로 @RequestBody Todo todo를 입력하면 된다 임포트를 정리한다
//org.springframework.web.bind.annotation.PostMapping 어노테이션이 임포트되고 RequestBody 어노테이션이 임포트되는 걸 알 수 있다, 됐다 저장하고
	public void createTodosForSpecificUser(@PathVariable String username,
                                      @RequestBody Todo todo) {
		
	}

}

record Todo (String username, String description) {}
